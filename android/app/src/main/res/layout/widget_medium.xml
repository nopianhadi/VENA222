<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_medium_business"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Vena Pictures - Agenda Pemotretan"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:singleLine="true" />

        <TextView
            android:id="@+id/widget_medium_header_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_badge"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="Kalender ➔"
            android:textColor="#C7D2FE"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Cards Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal">

        <!-- Card 1 -->
        <LinearLayout
            android:id="@+id/widget_medium_card1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:background="@drawable/widget_card_item"
            android:orientation="vertical"
            android:padding="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_medium_card1_countdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/widget_badge"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="1dp"
                    android:text="Hari Ini"
                    android:textColor="#A5B4FC"
                    android:textSize="8sp" />

                <TextView
                    android:id="@+id/widget_medium_card1_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="14:00"
                    android:textColor="#94A3B8"
                    android:textSize="9sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_medium_card1_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Sarah &amp; Dimas"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:singleLine="true" />

            <TextView
                android:id="@+id/widget_medium_card1_location"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Hotel Mulia Senayan"
                android:textColor="#94A3B8"
                android:textSize="9sp"
                android:singleLine="true" />
        </LinearLayout>

        <!-- Card 2 -->
        <LinearLayout
            android:id="@+id/widget_medium_card2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="5dp"
            android:background="@drawable/widget_card_item"
            android:orientation="vertical"
            android:padding="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/widget_badge"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="1dp"
                    android:text="Mendatang"
                    android:textColor="#6EE7B7"
                    android:textSize="8sp" />

                <TextView
                    android:id="@+id/widget_medium_card2_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:text="09:00"
                    android:textColor="#94A3B8"
                    android:textSize="9sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_medium_card2_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Rian &amp; Jessica"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:singleLine="true" />

            <TextView
                android:id="@+id/widget_medium_card2_location"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="Hutan Pinus Mangunan"
                android:textColor="#94A3B8"
                android:textSize="9sp"
                android:singleLine="true" />
        </LinearLayout>
    </LinearLayout>

    <!-- Footer Stats -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_medium_projects"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="8 Proyek Aktif"
            android:textColor="#94A3B8"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/widget_medium_revenue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Omset: Rp 48.5 jt"
            android:textColor="#34D399"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
